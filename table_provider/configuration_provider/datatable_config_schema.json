{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataTable Configuration Schema",
  "description": "Schema for datatable configuration in TableManager",
  "type": "object",
  "required": ["tableId"],
  "additionalProperties": false,
  "properties": {
    "tableId": {
      "type": "string",
      "description": "Unique identifier for the table"
    },
    "serverSide": {
      "type": "boolean",
      "description": "Whether server-side processing is enabled"
    },
    "order": {
      "type": "array",
      "description": "Default sort order",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "string",
            "enum": ["asc", "desc"]
          }
        ]
      }
    },
    "ordering": {
      "type": "boolean",
      "description": "Whether sorting is enabled"
    },
    "paging": {
      "type": "boolean",
      "description": "Whether pagination is enabled"
    },
    "searching": {
      "type": "boolean",
      "description": "Whether global search is enabled"
    },
    "lengthMenu": {
      "type": "array",
      "description": "Options for rows per page",
      "items": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": -1
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "pageLength": {
      "type": "integer",
      "minimum": -1,
      "description": "Default number of rows per page (-1 for all)"
    },
    "scrollCollapse": {
      "type": "boolean",
      "description": "Whether to collapse scroll area when empty"
    },
    "scrollX": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "description": "Horizontal scroll configuration"
    },
    "scrollY": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ],
      "description": "Vertical scroll configuration"
    },
    "fixedHeader": {
      "type": "boolean",
      "description": "Whether to fix the header row"
    },
    "fixedColumns": {
      "type": "object",
      "description": "Fixed column configuration",
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dom": {
      "type": "string",
      "description": "DOM positioning string for DataTables elements"
    },
    "buttons": {
      "type": "array",
      "description": "Button configurations",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "columnDefs": {
      "type": "array",
      "description": "Column-specific configurations",
      "items": {
        "type": "object"
      }
    },
    "rowCallback": {
      "type": "string",
      "description": "Row callback function name or code"
    },
    "headerCallback": {
      "type": "string",
      "description": "Header callback function name or code"
    },
    "footerCallback": {
      "type": "string",
      "description": "Footer callback function name or code"
    },
    "nullValuePlaceholder": {
      "type": "string",
      "description": "Placeholder to display for null/undefined values",
      "default": "-"
    },
    "categoryCountColumnNames": {
      "type": "array",
      "description": "Columns for which to show category counts",
      "items": {
        "type": "string"
      }
    },
    "endpoints": {
      "type": "object",
      "description": "API endpoint URLs for server-side operations",
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "string",
          "description": "Main data listing endpoint"
        },
        "options": {
          "type": "string",
          "description": "Column options endpoint (with {column} placeholder)"
        },
        "range": {
          "type": "string",
          "description": "Numeric range endpoint (with {column} placeholder)"
        },
        "countdistinct": {
          "type": "string",
          "description": "Distinct count endpoint"
        },
        "checkbox": {
          "type": "string",
          "description": "Checkbox search set endpoint"
        }
      }
    },
    "superHeader": {
      "type": "object",
      "description": "Super header configuration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "colspan": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
