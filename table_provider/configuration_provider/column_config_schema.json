{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Column Configuration Schema",
  "description": "Schema for column configuration in TableManager",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["json_id", "data_type"],
    "additionalProperties": false,
    "properties": {
      "json_id": {
        "type": "string",
        "description": "Unique identifier for the column"
      },
      "title": {
        "type": "string",
        "description": "Display title for the column"
      },
      "column_group": {
        "type": "string",
        "description": "Group name for the column header"
      },
      "data_type": {
        "type": "string",
        "enum": ["text", "textselect", "numeric", "checkbox", "weblinktext"],
        "description": "Data type for the column"
      },
      "allow_filter": {
        "type": "boolean",
        "description": "Whether filtering is allowed for this column"
      },
      "orderable": {
        "type": "boolean",
        "description": "Whether the column is sortable"
      },
      "visible": {
        "type": "boolean",
        "description": "Whether the column is visible by default"
      },
      "precision": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of decimal places for numeric types"
      },
      "max_display_length": {
        "type": "integer",
        "minimum": 1,
        "description": "Maximum display length for text cells"
      },
      "cssClassCell": {
        "oneOf": [
          {
            "type": "string",
            "description": "Static CSS class name for cells (no underscores)"
          },
          {
            "type": "object",
            "description": "Dynamic cell styling configuration"
          }
        ]
      },
      "cellStyle": {
        "type": "object",
        "description": "Cell styling configuration",
        "oneOf": [
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "const": "categorical",
                "description": "Conditional categorical styling based on a source field"
              },
              "source": {
                "type": "string",
                "description": "Column json_id to check for the condition"
              },
              "rules": {
                "type": "object",
                "description": "Mapping of source value to CSS class name",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": ["type", "source", "rules"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "const": "gradient_greyscale",
                "description": "Gradient greyscale styling for numeric values"
              },
              "source": {
                "oneOf": [
                {
                  "type": "string",
                  "description": "Column json_id for the gradient (defaults to this column)"
                },
                {
                  "type": "array",
                  "description": "List of json_ids for the gradient"
                }
               ]
              },
              "shadingMin": {
                "type": "number",
                "description": "Minimum value for shading calculation"
              },
              "shadingMax": {
                "type": "number",
                "description": "Maximum value for shading calculation"
              },
              "valueClampMin": {
                "type": "number",
                "description": "Minimum value to clamp display to"
              },
              "valueClampMax": {
                "type": "number",
                "description": "Maximum value to clamp display to"
              }
            },
            "required": ["type"],
            "additionalProperties": false
          }
        ]
      },
      "cssClassHeaderCell": {
        "type": "string",
        "description": "Static CSS class name for header cells"
      },
      "cellInjectors": {
        "oneOf": [
          {
            "type": "string",
            "description": "Comma or semicolon-separated injector names (legacy format)"
          },
          {
            "type": "array",
            "description": "Array of injector names",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "filterHeaderInjector": {
        "oneOf": [
          {
            "type": "string",
            "description": "Single filter header injector name (legacy format)"
          },
          {
            "type": "array",
            "description": "Array of filter header injector names",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
